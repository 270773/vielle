# Copier en config.env (voir README)
LABELQC_DB_PATH=data/labelqc.db
LABELQC_PDF_ROOT=data/modeles          # {Fournisseur}/{Reference}/{Version}/modele.pdf
LABELQC_ARCHIVE_PATH=data/archives
LABELQC_OCR=off                       # on = lit aussi le texte (Tesseract + packs de langues requis)
LABELQC_OCR_LANGS=fra+eng+deu+spa
LABELQC_LIBRETRANSLATE_URL=            # vide = traduction desactivee
LABELQC_SCAN_INBOX=data/scans_entrants   # destination "scan vers dossier" du scanner (PNG/JPEG/TIFF/PDF)
