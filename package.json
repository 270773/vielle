{
  "name": "ged-doc-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype d'éditeur de documents structurés (cartouche standard + corps configurable) intégrable à une GED",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed/index.js",
    "test": "node --test test/*.test.js",
