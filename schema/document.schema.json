{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ged/document.schema.json",
  "title": "Document structuré GED",
  "description": "Un document = cartouche standard (meta + workflow + visas, pilotés par la GED) + corps configurable (blocs). Une annexe-carte porte `card` à la place de `body`.",
  "type": "object",
  "required": ["kind", "status", "workflow", "meta", "visas"],
  "properties": {
    "kind": { "enum": ["document", "annex-card"] },
    "status": { "enum": ["brouillon", "en_verification", "en_approbation", "en_vigueur", "annule"] },
    "layout": { "type": "object", "properties": { "orientation": { "enum": ["portrait", "landscape"] } }, "additionalProperties": false },
    "workflow": {
      "type": "object",
      "required": ["redacteur", "examinateur", "approbateur"],
      "properties": { "redacteur": { "type": "string" }, "examinateur": { "type": "string" }, "approbateur": { "type": "string" } },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["ref", "version", "title", "created"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "society": { "type": "string" },
        "logo": { "type": "string" },
        "dest": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "service": { "type": "string" },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "effective": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "annule": { "type": ["object", "null"], "properties": { "version": { "type": "integer" }, "date": { "type": ["string", "null"] } } },
        "annexes": { "type": "array", "items": { "type": "object", "required": ["ref"], "properties": { "ref": { "type": "string" } } } },
        "changeNote": { "type": "string" },
        "migration": { "type": "object" }
      }
    },
    "visas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "userId", "name", "function", "date", "hash"],
        "properties": {
          "role": { "enum": ["redacteur", "examinateur", "approbateur"] },
          "userId": { "type": "string" }, "name": { "type": "string" },
          "function": { "type": "string", "description": "Fonction figée à la date du visa (jamais relue dans l'annuaire)." },
          "date": { "type": "string" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "origin": { "type": "string" }
        }
      }
    },
    "body": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "card": {
      "type": "object",
      "required": ["faces"],
      "properties": {
        "faces": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["id", "blocks"], "properties": { "id": { "type": "string" }, "header": { "type": "object" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } } } }
        }
      }
    },
    "print": {
      "type": "object",
      "properties": {
        "perSheet": { "enum": [1, 2, 4] }, "cutMarks": { "type": "boolean" }, "mirrorVerso": { "type": "boolean" }, "qr": { "type": "boolean" },
        "formats": { "type": "array", "items": { "enum": ["pdf", "docx", "xlsx"] } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "document" } } }, "then": { "required": ["body"] } },
    { "if": { "properties": { "kind": { "const": "annex-card" } } }, "then": { "required": ["card"] } }
  ],
  "$defs": {
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "locked": { "type": "boolean", "description": "Bloc imposé par le modèle : non modifiable par le rédacteur." },
        "type": {
          "enum": ["heading", "text", "list", "callout", "keyvalue", "box", "columns", "photos", "image", "table", "docref", "annexes", "annexpreview",
                   "fields", "checks", "area", "choice", "yesno", "visatable", "checklist", "pagebreak", "spacer", "repeat", "slot"]
        }
      }
    }
  }
}
